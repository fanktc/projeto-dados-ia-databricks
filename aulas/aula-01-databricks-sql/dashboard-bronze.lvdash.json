{
  "datasets": [
    {
      "name": "ds_pedidos",
      "displayName": "Pedidos (bronze)",
      "queryLines": [
        "-- Tudo na bronze é texto. Todo acesso começa com CAST e com o coalesce\n",
        "-- de data: é o imposto que a camada silver vai eliminar na noite 2.\n",
        "SELECT pedido_id,\n",
        "       date_trunc('MONTH', coalesce(try_to_date(data_pedido, 'yyyy-MM-dd'),\n                    try_to_date(data_pedido, 'dd/MM/yyyy'))) AS mes,\n",
        "       canal,\n",
        "       CAST(valor_total AS DECIMAL(18,2)) AS valor\n",
        "FROM pedidos\n",
        "WHERE status <> 'Cancelado'"
      ]
    },
    {
      "name": "ds_margem",
      "displayName": "Margem global",
      "queryLines": [
        "SELECT SUM(CAST(i.valor_bruto AS DECIMAL(18,2))\n",
        "         - CAST(i.quantidade AS INT) * CAST(p.custo_unitario AS DECIMAL(18,2)))\n",
        "     / SUM(CAST(i.valor_bruto AS DECIMAL(18,2))) AS margem_pct\n",
        "FROM itens_pedido i\n",
        "JOIN produtos p  ON p.sku = i.sku\n",
        "JOIN pedidos  pe ON pe.pedido_id = i.pedido_id AND pe.status <> 'Cancelado'\n",
        "WHERE CAST(i.quantidade AS INT) > 0\n"
      ]
    },
    {
      "name": "ds_marca",
      "displayName": "Receita por marca",
      "queryLines": [
        "SELECT p.marca, SUM(CAST(i.valor_bruto AS DECIMAL(18,2))) AS receita\n",
        "FROM itens_pedido i\n",
        "JOIN produtos p  ON p.sku = i.sku\n",
        "JOIN pedidos  pe ON pe.pedido_id = i.pedido_id AND pe.status <> 'Cancelado'\n",
        "WHERE CAST(i.quantidade AS INT) > 0\n",
        "GROUP BY 1 ORDER BY receita DESC"
      ]
    },
    {
      "name": "ds_categoria",
      "displayName": "Margem por categoria",
      "queryLines": [
        "SELECT p.categoria,\n",
        "       SUM(CAST(i.valor_bruto AS DECIMAL(18,2))\n",
        "           - CAST(i.quantidade AS INT) * CAST(p.custo_unitario AS DECIMAL(18,2)))\n",
        "         / SUM(CAST(i.valor_bruto AS DECIMAL(18,2))) AS margem_pct\n",
        "FROM itens_pedido i\n",
        "JOIN produtos p  ON p.sku = i.sku\n",
        "JOIN pedidos  pe ON pe.pedido_id = i.pedido_id AND pe.status <> 'Cancelado'\n",
        "WHERE CAST(i.quantidade AS INT) > 0\n",
        "GROUP BY 1 ORDER BY margem_pct DESC"
      ]
    },
    {
      "name": "ds_clientes",
      "displayName": "Melhores clientes",
      "queryLines": [
        "SELECT initcap(trim(c.razao_social)) AS cliente, c.segmento, c.cidade,\n",
        "       COUNT(DISTINCT p.pedido_id)              AS pedidos,\n",
        "       SUM(CAST(p.valor_total AS DECIMAL(18,2))) AS receita\n",
        "FROM pedidos p\n",
        "JOIN clientes c ON CAST(c.cliente_id AS INT) = CAST(p.cliente_id AS INT)\n",
        "WHERE p.status <> 'Cancelado'\n",
        "GROUP BY 1, 2, 3 ORDER BY receita DESC LIMIT 15"
      ]
    }
  ],
