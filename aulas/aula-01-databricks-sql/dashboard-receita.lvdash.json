{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas por mês, canal, categoria e marca",
      "queryLines": [
        "SELECT date_trunc('MONTH', data_pedido) AS mes,\n",
        "       canal, categoria, marca,\n",
        "       SUM(receita)              AS receita,\n",
        "       SUM(margem)               AS margem,\n",
        "       COUNT(DISTINCT pedido_id) AS pedidos,\n",
        "       SUM(quantidade)           AS unidades\n",
        "FROM fato_vendas\n",
        "GROUP BY 1, 2, 3, 4\n",
        "ORDER BY 1"
      ],
      "columns": [
        {"displayName": "Receita",      "description": "Receita líquida, já sem devolução",
         "expression": "SUM(`receita`)"},
        {"displayName": "Margem %",     "description": "Margem sobre a receita",
         "expression": "SUM(`margem`) / NULLIF(SUM(`receita`), 0)"},
        {"displayName": "Pedidos",      "description": "Pedidos distintos",
         "expression": "SUM(`pedidos`)"},
        {"displayName": "Ticket médio", "description": "Receita dividida por pedido",
         "expression": "SUM(`receita`) / NULLIF(SUM(`pedidos`), 0)"}
      ]
    },
    {
      "name": "ds_clientes",
      "displayName": "Melhores clientes",
      "queryLines": [
        "SELECT c.razao_social AS cliente, c.segmento, c.cidade,\n",
        "       COUNT(DISTINCT f.pedido_id) AS pedidos,\n",
        "       SUM(f.receita)              AS receita,\n",
        "       SUM(f.margem) / NULLIF(SUM(f.receita), 0) AS margem_pct\n",
        "FROM fato_vendas f\n",
        "JOIN dim_cliente c ON c.cliente_id = f.cliente_id\n",
        "GROUP BY 1, 2, 3\n",
        "ORDER BY receita DESC\n",
        "LIMIT 15"
      ]
    }
  ],
  "pages": [
    {
      "name": "visao_geral",
      "displayName": "Receita e clientes",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "titulo",
            "textbox_spec": "# Rota do Perfume · a pergunta da noite 1\n\nQual foi nossa receita e quem são os melhores clientes? O pico **não** é dezembro: o varejo compra **antes** da data, então o mês forte da distribuidora é o anterior — abril, junho e outubro."
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-receita",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_vendas",
              "fields": [
                {"name": "measure(Receita)", "expression": "MEASURE(`Receita`)"},
                {"name": "monthly(mes)", "expression": "DATE_TRUNC(\"MONTH\", `mes`)"}
              ], "disaggregated": false}}],
            "spec": {
              "version": 2, "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "measure(Receita)", "displayName": "Receita",
                  "format": {"type": "number-currency", "currencyCode": "BRL",
                             "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 1}}},
                "period": {"fieldName": "monthly(mes)"}
              },
              "frame": {"showTitle": true, "title": "Receita no período"}
            }
          },
          "position": {"x": 0, "y": 3, "width": 3, "height": 4}
        },
        {
          "widget": {
            "name": "kpi-pedidos",
