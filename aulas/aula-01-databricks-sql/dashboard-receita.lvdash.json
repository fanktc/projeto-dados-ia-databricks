              "fields": [
                {"name": "measure(Pedidos)", "expression": "MEASURE(`Pedidos`)"},
                {"name": "monthly(mes)", "expression": "DATE_TRUNC(\"MONTH\", `mes`)"}
              ], "disaggregated": false}}],
            "spec": {
              "version": 2, "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "measure(Pedidos)", "displayName": "Pedidos",
                  "format": {"type": "number-plain", "abbreviation": "compact",
                             "decimalPlaces": {"type": "max", "places": 1}}},
