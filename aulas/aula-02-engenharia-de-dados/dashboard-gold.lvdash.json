{
  "datasets": [
    {
      "name": "ds_pedidos",
      "displayName": "Pedidos faturados",
      "queryLines": [
        "-- grão: um pedido por linha. Assim AVG() já é o ticket médio correto,\n",
        "-- sem precisar de razão de somas.\n",
        "SELECT pedido_id,\n",
        "       date_trunc('MONTH', data_pedido) AS mes,\n",
        "       canal,\n",
        "       SUM(receita) AS valor\n",
        "FROM fato_vendas\n",
        "GROUP BY 1, 2, 3\n",
        "ORDER BY 2"
      ]
    },
    {
      "name": "ds_margem",
      "displayName": "Margem global",
      "queryLines": [
        "SELECT SUM(margem) / SUM(receita) AS margem_pct FROM fato_vendas"
      ]
    },
    {
      "name": "ds_marca",
      "displayName": "Receita por marca",
      "queryLines": [
        "SELECT marca, SUM(receita) AS receita\n",
        "FROM fato_vendas GROUP BY 1 ORDER BY receita DESC"
      ]
    },
    {
      "name": "ds_categoria",
      "displayName": "Margem por categoria",
      "queryLines": [
        "SELECT categoria,\n",
        "       SUM(receita) AS receita,\n",
        "       SUM(margem) / SUM(receita) AS margem_pct\n",
        "FROM fato_vendas GROUP BY 1 ORDER BY margem_pct DESC"
      ]
    },
    {
      "name": "ds_clientes",
      "displayName": "Melhores clientes",
      "queryLines": [
        "SELECT c.razao_social AS cliente, c.segmento, c.cidade,\n",
        "       COUNT(DISTINCT f.pedido_id) AS pedidos,\n",
        "       SUM(f.receita) AS receita\n",
        "FROM fato_vendas f\n",
        "JOIN dim_cliente c ON c.cliente_id = f.cliente_id\n",
        "GROUP BY 1, 2, 3 ORDER BY receita DESC LIMIT 15"
      ]
    }
  ],
